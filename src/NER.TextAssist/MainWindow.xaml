<Window x:Class="NER.TextAssist.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NER Text Assist"
        Width="1080"
        Height="700"
        MinWidth="880"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="#F6F7F9">
    <Window.Resources>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#202328" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#F2F3F5" />
            <Setter Property="Foreground" Value="#373B41" />
            <Setter Property="BorderBrush" Value="#E0E2E6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="13,8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
            <RowDefinition Height="42" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#E6E8EC" BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="44" Height="44" CornerRadius="10" Background="White" VerticalAlignment="Center">
                    <Image Source="/Assets/NER-Text-Assist-Icon.png" Stretch="Uniform" Margin="2" />
                </Border>

                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="NER Text Assist" FontSize="21" FontWeight="SemiBold" Foreground="#17191C" />
                    <TextBlock Text="Autocomplete berbasis sumber lokal" FontSize="12" Foreground="#6B7078" />
                </StackPanel>

                <Border Grid.Column="2" Padding="10,5" CornerRadius="12" Background="#EEF1F4" VerticalAlignment="Center">
                    <TextBlock Text="v0.2.2 · Tahap 1" FontSize="11" Foreground="#50555D" />
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="14" BorderBrush="#E4E6EA" BorderThickness="1">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="Sumber Teks" FontSize="20" FontWeight="SemiBold" Foreground="#202328" />
                        <TextBlock Margin="0,5,0,0"
                                   Text="Import dokumen yang akan menjadi bahan autocomplete."
                                   FontSize="12" Foreground="#747982" TextWrapping="Wrap" />
                    </StackPanel>

                    <Button x:Name="ImportButton"
                            Grid.Row="1"
                            Margin="0,16,0,14"
                            HorizontalAlignment="Stretch"
                            Content="+ Import Sumber"
                            Style="{StaticResource PrimaryButton}"
                            Click="ImportSource_Click" />

                    <ListBox x:Name="SourceListBox"
                             Grid.Row="2"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="SourceListBox_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,7" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12" Background="#FAFAFB" BorderBrush="#E7E9EC" BorderThickness="1" CornerRadius="9">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="#272A2F" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Margin="0,4,0,0" Text="{Binding Summary}" FontSize="11" Foreground="#747982" />
                                        <TextBlock Margin="0,2,0,0" Text="{Binding ImportedAtLabel}" FontSize="10" Foreground="#9A9EA5" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Grid.Row="3" Margin="0,12,0,0"
                               Text="Format: TXT · DOCX · CSV · XLSX"
                               FontSize="10" Foreground="#8D9299" HorizontalAlignment="Center" />
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="White" CornerRadius="14" BorderBrush="#E4E6EA" BorderThickness="1">
                <Grid Margin="22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="PreviewTitleText" Text="Preview Teks" FontSize="20" FontWeight="SemiBold" Foreground="#202328" TextTrimming="CharacterEllipsis" />
                            <TextBlock Margin="0,5,0,0" Text="Hanya teks yang diekstrak. Gambar dan konten visual diabaikan." FontSize="12" Foreground="#747982" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button x:Name="DeleteSourceButton"
                                Grid.Column="1"
                                Margin="16,0,0,0"
                                Content="Hapus Sumber"
                                Style="{StaticResource SecondaryButton}"
                                VerticalAlignment="Top"
                                IsEnabled="False"
                                Click="DeleteSource_Click" />
                    </Grid>

                    <Border Grid.Row="1" Margin="0,16,0,12" Padding="10,7" Background="#F6F7F9" CornerRadius="7">
                        <TextBlock x:Name="PreviewMetaText" Text="Belum ada sumber yang dipilih." FontSize="11" Foreground="#666B73" TextWrapping="Wrap" />
                    </Border>

                    <TextBox x:Name="PreviewTextBox"
                             Grid.Row="2"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"
                             BorderBrush="#E1E3E7"
                             BorderThickness="1"
                             Background="#FCFCFD"
                             Foreground="#2D3035"
                             FontSize="13"
                             Padding="14"
                             Text="Import TXT, DOCX, CSV, atau XLSX untuk melihat hasil ekstraksi teks di sini." />
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="White" BorderBrush="#E6E8EC" BorderThickness="0,1,0,0">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="Siap." FontSize="11" Foreground="#858A92" VerticalAlignment="Center" />
                <TextBlock x:Name="SourceCountText" Grid.Column="1" Text="0 sumber" FontSize="11" Foreground="#858A92" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
