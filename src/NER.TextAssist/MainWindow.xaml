<Window x:Class="NER.TextAssist.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NER Text Assist"
        Width="980"
        Height="640"
        MinWidth="820"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="#F6F7F9">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
            <RowDefinition Height="42" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#E6E8EC" BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="44" Height="44" CornerRadius="10" Background="White" VerticalAlignment="Center">
                    <Image Source="/Assets/NER-Text-Assist-Icon.png" Stretch="Uniform" Margin="2" />
                </Border>

                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="NER Text Assist" FontSize="21" FontWeight="SemiBold" Foreground="#17191C" />
                    <TextBlock Text="Text autocomplete berbasis sumber" FontSize="12" Foreground="#6B7078" />
                </StackPanel>

                <Border Grid.Column="2" Padding="10,5" CornerRadius="12" Background="#EEF1F4" VerticalAlignment="Center">
                    <TextBlock Text="v0.1.0 · Fondasi" FontSize="11" Foreground="#50555D" />
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28">
                <Grid Margin="0,0,0,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="190" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Fondasi aplikasi siap" FontSize="28" FontWeight="SemiBold" Foreground="#17191C" />
                        <TextBlock Margin="0,7,18,0"
                                   Text="Kerangka Windows untuk pengembangan autocomplete lintas aplikasi, sumber teks, dan command substitution."
                                   FontSize="14" Foreground="#666B73" TextWrapping="Wrap" />
                    </StackPanel>
                    <Image Grid.Column="1" Source="/Assets/NER-Text-Assist-Brand.png" Stretch="Uniform" MaxHeight="150" HorizontalAlignment="Right" />
                </Grid>

                <UniformGrid Columns="3">
                    <Border Margin="0,0,10,0" Padding="20" Background="White" CornerRadius="14" BorderBrush="#E4E6EA" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="01" FontSize="11" FontWeight="Bold" Foreground="#8A8F97" />
                            <TextBlock Margin="0,12,0,6" Text="Sumber Teks" FontSize="17" FontWeight="SemiBold" Foreground="#202328" />
                            <TextBlock Text="Import file dan input teks akan ditempatkan di modul ini." TextWrapping="Wrap" FontSize="12" Foreground="#747982" />
                        </StackPanel>
                    </Border>

                    <Border Margin="5,0" Padding="20" Background="White" CornerRadius="14" BorderBrush="#E4E6EA" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="02" FontSize="11" FontWeight="Bold" Foreground="#8A8F97" />
                            <TextBlock Margin="0,12,0,6" Text="Autocomplete Engine" FontSize="17" FontWeight="SemiBold" Foreground="#202328" />
                            <TextBlock Text="Mesin pencarian kandidat dan penyelesaian teks menjadi fokus utama." TextWrapping="Wrap" FontSize="12" Foreground="#747982" />
                        </StackPanel>
                    </Border>

                    <Border Margin="10,0,0,0" Padding="20" Background="White" CornerRadius="14" BorderBrush="#E4E6EA" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="03" FontSize="11" FontWeight="Bold" Foreground="#8A8F97" />
                            <TextBlock Margin="0,12,0,6" Text="System Integration" FontSize="17" FontWeight="SemiBold" Foreground="#202328" />
                            <TextBlock Text="Integrasi input Windows dan text substitution ditambahkan bertahap." TextWrapping="Wrap" FontSize="12" Foreground="#747982" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Margin="0,24,0,0" Padding="20" Background="White" CornerRadius="14" BorderBrush="#E4E6EA" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Update-safe foundation" FontSize="15" FontWeight="SemiBold" Foreground="#202328" />
                            <TextBlock Margin="0,5,0,0" Text="App identity dan installer ID dikunci sejak versi pertama agar versi berikutnya dapat menimpa instalasi lama." FontSize="12" Foreground="#747982" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="READY" Margin="24,0,0,0" FontSize="11" FontWeight="Bold" Foreground="#4B525A" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="White" BorderBrush="#E6E8EC" BorderThickness="0,1,0,0">
            <TextBlock Margin="24,0" Text="NER Text Assist · Windows Desktop" FontSize="11" Foreground="#858A92" VerticalAlignment="Center" />
        </Border>
    </Grid>
</Window>
